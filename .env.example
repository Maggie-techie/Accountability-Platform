# MongoDB Atlas connection string replace woth your connection string 
MONGODB_URI=

# JWT Secret (REQUIRED for authentication)
JWT_SECRET_KEY=

# AI Engine (GROQ API) - Get key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# AI Cache TTL (hours)
AI_CACHE_TTL_HOURS=24

